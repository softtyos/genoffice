{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // the docs/markdown editor modules are typed against the DOM even though genoffice runs them under jsdom
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    // resolve sibling source packages by path (worktree-safe, see pdf2docx/tsconfig.json)
    "paths": {
      "@softty/doc2docx": ["../doc2docx/src/index.ts"],
      "@softty/docx-engine": ["../docx-engine/src/index.ts"],
      "@softty/pptx-engine": ["../pptx-engine/src/index.ts"],
      "@softty/pdf2docx": ["../pdf2docx/src/index.ts"],
      "@softty/pptx-ops": ["../pptx-ops/src/index.ts"],
      "@softty/pptx-render": ["../pptx-render/src/index.ts"],
      "@softty/pipelines/slides": ["../pipelines/src/slides/index.ts"],
      "@softty/pptx-ops/op-docs": ["../pptx-ops/src/op-docs.ts"],
      "@softty/pptx-ops/font-size": ["../pptx-ops/src/font-size.ts"],
      "@softty/xlsx-gateway/*": ["../xlsx-gateway/src/*"],
      "@softty/font-metrics": ["../font-metrics/src/index.ts"],
      "@softty/electron-utils": ["../electron-utils/src/index.ts"],
      "@softty/electron-utils/*": ["../electron-utils/src/*"],
      "@softty/ai-search": ["../ai-search/src/index.ts"],
      "@softty/ai-provider": ["../ai-provider/src/index.ts"],
      "@softty/ai-provider/browser": ["../ai-provider/src/browser.ts"],
      "@softty/i18n": ["../i18n/src/index.ts"],
      "@softty/ui": ["../ui/src/index.ts"]
    }
  },
  // ambient declarations travel with the sources genoffice reuses: package module shims and the
  // renderer window globals (window.desktop / window.markdownApi) the editor modules reference
  "include": [
    "src",
    "tests",
    "../pdf2docx/src/bidi-js.d.ts",
    "../pptx-ops/src/raw.d.ts",
    "../../apps/docs/src/renderer/env.d.ts",
    "../../apps/markdown/src/renderer/env.d.ts",
    "../../apps/markdown/src/renderer/types/wavedrom.d.ts"
  ]
}
