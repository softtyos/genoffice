#!/bin/sh
# Softty Office CLI launcher (soffice / softty-office).
# Inside a packaged Softty Office it runs the bundled CLI on the app's own Node
# runtime (ELECTRON_RUN_AS_NODE); in a dev checkout it falls back to the system
# node and the local build output.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)

if [ -n "$GENOFFICE_NODE" ]; then
  exec "$GENOFFICE_NODE" "$here/genoffice.cjs" "$@"
fi

case "$here" in
  */Contents/Resources/cli)
    if [ -x "$here/../../MacOS/Softty Office" ]; then
      app="$here/../../MacOS/Softty Office"
    else
      app="$here/../../MacOS/GenOffice"
    fi
    ;;
  */resources/cli)
    # Linux install, or the Windows install reached from Git Bash / MSYS
    if [ -x "$here/../../Softty Office.exe" ]; then
      app="$here/../../Softty Office.exe"
    elif [ -x "$here/../../GenOffice.exe" ]; then
      app="$here/../../GenOffice.exe"
    elif [ -x "$here/../../Softty Office" ]; then
      app="$here/../../Softty Office"
    elif [ -x "$here/../../softty-office" ]; then
      app="$here/../../softty-office"
    else
      app="$here/../../genoffice"
    fi
    ;;
  *) app="" ;;
esac

if [ -n "$app" ] && [ -x "$app" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$app" "$here/genoffice.cjs" "$@"
fi

if [ -f "$here/genoffice.cjs" ]; then
  exec node "$here/genoffice.cjs" "$@"
fi
exec node "$here/../dist/genoffice.cjs" "$@"
