{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // resolve the sibling source packages by path (worktree-safe: a linked
    // node_modules would otherwise typecheck against another checkout)
    "paths": {
      "@softty/docx-engine": ["../docx-engine/src/index.ts"],
      "@softty/pptx-engine": ["../pptx-engine/src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
