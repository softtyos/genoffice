{
  "name": "@softty/mobile",
  "version": "1.0.5",
  "private": true,
  "description": "Softty Office Mobile Companion App (Softty Drop & Document Scanner)",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "release": "npm run build:aab && npm run build:ios",
    "release:android": "npm run build:aab",
    "release:ios": "npm run build:ios",
    "release:apk": "npm run build:apk",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production",
    "build:ios": "npx eas-cli build -p ios --profile production",
    "build:local:apk": "npx eas-cli build -p android --profile preview --local",
    "build:local:aab": "npx eas-cli build -p android --profile production --local",
    "build:local:ios": "npx eas-cli build -p ios --profile production --local"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.22",
    "expo-asset": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "^57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-print": "^57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "^57.0.25",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
