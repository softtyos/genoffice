{
  "expo": {
    "name": "Softty Office",
    "slug": "softty-office",
    "scheme": "softty-office",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.softty.office.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Softty Office cần quyền truy cập camera để quét tài liệu, hóa đơn chuyển thành file PDF.",
        "NSPhotoLibraryUsageDescription": "Softty Office cần quyền truy cập thư viện ảnh để chọn ảnh tài liệu cần gửi sang máy tính.",
        "NSLocalNetworkUsageDescription": "Softty Office cần quyền truy cập mạng cục bộ để tự động tìm kiếm máy tính trong cùng mạng Wi-Fi (Softty Drop).",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Microsoft Word Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.microsoft.word.doc",
              "org.openxmlformats.wordprocessingml.document"
            ]
          },
          {
            "CFBundleTypeName": "Microsoft Excel Spreadsheet",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.microsoft.excel.xls",
              "org.openxmlformats.spreadsheetml.sheet"
            ]
          },
          {
            "CFBundleTypeName": "Microsoft PowerPoint Presentation",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.microsoft.powerpoint.ppt",
              "org.openxmlformats.presentationml.presentation"
            ]
          },
          {
            "CFBundleTypeName": "Text & Markdown Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.plain-text",
              "net.daringfireball.markdown",
              "public.comma-separated-values-text",
              "public.html"
            ]
          }
        ]
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "net.softty.office.mobile",
      "versionCode": 6,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "application/msword"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "mimeType": "application/vnd.ms-powerpoint"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/markdown"
            },
            {
              "mimeType": "text/csv"
            },
            {
              "mimeType": "text/tab-separated-values"
            },
            {
              "mimeType": "text/html"
            }
          ]
        }
      ]
    }
  }
}
