{
  "name": "softty-office",
  "productName": "Softty Office",
  "appId": "net.softty.office",
  "version": "1.0.3",
  "license": "Apache-2.0",
  "homepage": "https://office.softty.net",
  "private": true,
  "description": "Unified Softty Office shell: one app hosting the docs, sheets, slides, pdf, markdown, and html modules",
  "main": "out/main/index.js",
  "desktopName": "softty-office.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@softty/agent-core": "workspace:*",
    "@softty/ai-provider": "workspace:*",
    "@softty/ai-search": "workspace:*",
    "@softty/docs": "workspace:*",
    "@softty/docx-engine": "workspace:*",
    "@softty/electron-utils": "workspace:*",
    "@softty/file-parse": "workspace:*",
    "@softty/cli": "workspace:*",
    "@softty/i18n": "workspace:*",
    "@softty/pipelines": "workspace:*",
    "@softty/pptx-engine": "workspace:*",
    "@softty/pptx-ops": "workspace:*",
    "@softty/pptx-render": "workspace:*",
    "@softty/sheets": "workspace:*",
    "@softty/slides": "workspace:*",
    "@softty/project-store": "workspace:*",
    "@softty/ui": "workspace:*",
    "@softty/xlsx-gateway": "workspace:*",
    "@embedpdf/pdfium": "^2.15.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.8.3",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "jszip": "^3.10.1",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "undici": "^6.29.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "author": "Softty.net"
}
