{
  "name": "@softty/docs",
  "productName": "Softty Docs",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-native streaming docx editor with paragraph-patch save",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@softty/agent-core": "workspace:*",
    "@softty/i18n": "workspace:*",
    "@softty/ai-provider": "workspace:*",
    "@softty/ai-search": "workspace:*",
    "@softty/docx-engine": "workspace:*",
    "@softty/file-parse": "workspace:*",
    "@softty/project-store": "workspace:*",
    "@softty/ui": "workspace:*",
    "@tiptap/core": "3.31.0",
    "@tiptap/extensions": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.8.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "marked": "^17.0.6",
    "opentype.js": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "author": "Softty.net",
  "build": {
    "appId": "net.softty.docs",
    "productName": "Softty Docs",
    "electronVersion": "43.3.0",
    "artifactName": "AIDocx-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@softty/electron-utils": "workspace:*",
    "@softty/font-metrics": "workspace:*",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "@softty/pptx-render": "workspace:*",
    "@softty/xlsx-gateway": "workspace:*",
    "@softty/agent-core": "workspace:*"
  }
}
